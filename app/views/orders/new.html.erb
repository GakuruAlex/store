<div class="flex justify-center ">
  <div class="max-w-2xl w-full bg-white p-8 rounded-lg shadow-lg">
    <%= form_with(model: @order, class: "space-y-6") do |order_form| %>

      <!-- Date + Customer -->
      <div class="grid grid-cols-2 gap-6">
        <div>
          <%= order_form.label :date_of_purchase, "Date of Purchase", class: "block mb-2 text-sm font-medium text-gray-700" %>
          <%= order_form.date_field :date_of_purchase, class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900" %>
        </div>

        <div>
          <% if @customer %>
            <%= label_tag :customer_name, "Customer", class: "block mb-2 text-sm font-medium text-gray-700" %>
            <%= text_field_tag :customer_name, @customer.name, disabled: true, class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900" %>
            <%= order_form.hidden_field :customer_id, value: @customer.id %>
          <% else %>
            <%= order_form.label :customer_id, "Customer", class: "block mb-2 text-sm font-medium text-gray-700" %>
            <%= order_form.select :customer_id, Customer.all.collect { |c| [c.name, c.id] }, {}, class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900" %>
          <% end %>
        </div>
      </div>

      <!-- Products -->
      <div class="space-y-4">
        <%= order_form.fields_for :order_products do |order_product_form| %>
          <div class="grid grid-cols-2 gap-6">
            <div>
              <%= order_product_form.label :product_id, "Product", class: "block mb-2 text-sm font-medium text-gray-700" %>
              <%= order_product_form.select :product_id, Product.all.collect { |p| [p.name, p.id] }, {}, class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900" %>
            </div>
            <div>
              <%= order_product_form.label :quantity, "Quantity", class: "block mb-2 text-sm font-medium text-gray-700" %>
              <%= order_product_form.number_field :quantity, in: 1..100, step: 1, class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm text-gray-900" %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Submit -->
      <div class="flex justify-center">
        <%= order_form.submit "Place Order", class: "bg-indigo-600 text-white py-2 px-6 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 shadow-md hover:shadow-lg transition-shadow" %>
      </div>

    <% end %>
  </div>
</div>
