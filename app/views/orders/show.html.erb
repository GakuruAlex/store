<div class="max-w-5xl mx-auto bg-white rounded-xl shadow-lg p-8 space-y-8">
  <!-- Header with actions -->
  <div class="flex items-center justify-between border-b pb-4">
    <h2 class="text-2xl font-bold text-gray-800">Order <%= @order.id %></h2>
    <div class="space-x-3">
      <%= link_to "View All Orders", orders_path, class: "btn-primary" %>
      <%= link_to "Edit", edit_order_path(@order), class: "btn-warning" %>
      <%= link_to "Delete", order_path(@order), method: :delete, data: { confirm: "Are you sure?" }, class: "btn-danger" %>
    </div>
  </div>

  <!-- Two-column layout -->
  <div class="grid grid-cols-2 gap-8">
    <!-- Left: Customer Info -->
    <div class="space-y-2">
      <h3 class="text-lg font-semibold text-gray-700">Customer Info</h3>
      <nav class="flex items-center mb-6 text-gray-500 text-sm">
        <%= link_to "Back to Customer",
                    customer_path(@order.customer),
                    class: "hover:text-blue-600 transition" %>

        <span class="mx-2">/</span>

        <span class="text-gray-800 font-semibold">
          <%= @order.customer.name %>
        </span>
      </nav>
      <p class="text-sm text-gray-500">Purchased on <%= @order.date_of_purchase.strftime("%d/%m/%Y") %></p>
    </div>

    <!-- Right: Products --> <div class="space-y-4">
    <h3 class="text-lg font-semibold text-gray-800">Products</h3>
    <% @order.order_products.each do |op| %>
      <div class="flex justify-between items-center border rounded-md p-5 bg-gray-50">
        <!-- Product name + quantity -->
        <div> <p class="font-medium text-gray-900">
          <%= op.product.name %>
        </p>
          <p class="text-sm text-gray-600">
            Qty: <%= op.quantity %>
          </p>
        </div> <!-- Extended price (quantity × unit price) -->
        <div class="text-right">
          <p class="text-gray-800 font-semibold">
    $<%= op.quantity * op.product.price %>
  </p>
          <p class="text-xs text-gray-500">
            (@ $<%= op.product.price %> each)
          </p>
        </div>
      </div>
    <% end %>
  </div>
  </div>

  <!-- Total -->
  <div class="border-t pt-6 text-right">
    <h3 class="text-lg font-semibold text-gray-700">Total Amount</h3>
    <p class="text-3xl font-bold text-green-600">$<%= @order.amount %></p>
  </div>
</div>
