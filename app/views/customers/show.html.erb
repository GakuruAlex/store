<div class="max-w-4xl mx-auto mt-12 space-y-8 p-4">
  <!-- Breadcrumb -->
  <nav class="flex items-center mb-6 text-gray-500 text-sm">
    <%= link_to "Customers", customers_path, class: "hover:text-blue-600 transition" %>
    <span class="mx-2">/</span>
    <span class="text-gray-800 font-semibold"><%= @customer.name %></span>
  </nav>

  <!-- Customer Card -->
  <div class="bg-white shadow-lg rounded-2xl border border-gray-100 p-6">
    <div class="text-center">
      <p class="text-sm text-gray-500 uppercase font-semibold">Date Created</p>
      <p class="text-lg font-medium text-gray-900">
        <%= @customer.created_at.strftime("%B %d, %Y") %>
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap justify-center mt-6 gap-4">
      <%= link_to edit_customer_path(@customer),
                  class: "inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-full shadow hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
        </svg>
        Edit Customer
      <% end %>

      <%= link_to customer_path(@customer),
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this customer?" },
                  class: "inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-red-600 bg-white border border-gray-200 rounded-full shadow hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-300" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <!-- Orders Card -->
  <div class="w-full max-w-sm mx-auto p-6 bg-gray-50 border border-gray-200 rounded-xl shadow">
    <div class="flex items-center justify-between mb-4">
      <h5 class="text-lg font-semibold text-gray-800">Latest Orders</h5>
    </div>

    <ul role="list" class="divide-y divide-gray-200">
      <% @orders.each do |order| %>
        <li class="py-4 flex items-center justify-between">
          <div class="flex-1">
            <p class="font-medium text-gray-900">Order #<%= order.id %></p>
            <p class="text-sm text-gray-500">Date: <%= order.date_of_purchase.strftime("%d/%m/%Y") %></p>
          </div>
          <div class="text-sm font-semibold text-blue-600">
            $<%= order.amount %>
          </div>
          <%= link_to order_path(order),
                      class: "ml-4 inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-red-600 bg-white border border-gray-200 rounded-lg hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-300" do %>
                        View
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
